# ==============================================================================
# VALIDATEX --- Environment Variables Configuration (.env.example)
# Problem Statement: SIH26261 / AICTE Smart Automation
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Authentication & JWT Configuration
JWT_SECRET=validx-super-secure-jwt-secret-key-replace-in-production
JWT_EXPIRES_IN=24h

# Storage Vault Configuration
# Vault directory stores private uploaded documents outside public static paths
DATA_DIR=./data
STORAGE_DIR=./data/vault
REPORTS_DIR=./data/reports
MAX_FILE_SIZE_MB=15

# Database Configuration
# In development, VALIDATEX uses zero-config atomic persistent JSON/relational engine
# For PostgreSQL in production, set DATABASE_URL=postgresql://user:pass@localhost:5432/validx
DATABASE_URL=
DB_FILE=./data/validx_database.json

# AI Provider Configuration
# Options: 'local_heuristic' (default zero-token ground truth), 'gemini', 'openai'
AI_PROVIDER=local_heuristic
AI_MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
